{
  "experiment_name": "transformer_base_no_cleaning",
  "description": "Base Transformer model without data cleaning - Raw WMT14 data",

  "model": {
    "model_type": "custom",
    "model_dim": 512,
    "num_heads": 8,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "ffn_dim": 2048,
    "dropout": 0.1,
    "max_seq_length": 256,
    "kdim": 64,
    "vdim": 64
  },

  "training": {
    "batch_size": 16,
    "learning_rate": 1e-4,
    "warmup_steps": 32000,
    "max_epochs": 4,
    "gradient_clip": 1.0,
    "tokens_per_batch": 25000,
    "max_tokens_per_batch": 25000,
    "accumulate_grad_batches": 1,
    "label_smoothing": 0.1,
    "debug_output_every": 100,
    "enable_output_debug": true
  },

  "data": {
    "dataset": "wmt14_en_de",
    "vocab_size": 37000,
    "src_vocab_size": 37000,
    "tgt_vocab_size": 37000,
    "shared_vocab": true,
    "encoding": "bpe",
    "apply_data_cleaning": false,
    "approximate_sentence_pairs": 4520620,
    "train_pairs": 4520620,
    "val_pairs": 500000,
    "pad_token": 0,
    "bos_token": 1,
    "eos_token": 2,
    "unk_token": 3,
    "src_lang": "en",
    "tgt_lang": "de"
  },

  "evaluation": {
    "eval_every": 10000,
    "save_every": 10000,
    "n_checkpoints": 5,
    "beam_size": 4,
    "length_penalty": 0.6
  },

  "paths": {
    "data_path": "data/",
    "model_save_path": "checkpoints/base_no_cleaning/",
    "log_path": "logs/base_no_cleaning/"
  }
}
