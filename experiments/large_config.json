{
  "experiment_name": "transformer_large",
  "description": "Large Transformer model for high-performance training",

  "model": {
    "model_dim": 1024,
    "num_heads": 16,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "ffn_dim": 4096,
    "dropout": 0.3,
    "max_seq_length": 1024
  },

  "training": {
    "batch_size": 16,
    "learning_rate": 5e-5,
    "warmup_steps": 8000,
    "max_epochs": 200,
    "gradient_clip": 1.0
  },

  "data": {
    "dataset": "wmt14_en_de",
    "vocab_size": 50000,
    "shared_vocab": true,
    "encoding": "bpe",
    "approximate_sentence_pairs": 4500000,
    "pad_token": 0,
    "bos_token": 1,
    "eos_token": 2,
    "unk_token": 3,
    "src_lang": "en",
    "tgt_lang": "de"
  },

  "evaluation": {
    "eval_every": 1000,
    "save_every": 2000
  },

  "paths": {
    "data_path": "data/",
    "model_save_path": "checkpoints/large/",
    "log_path": "logs/large/"
  }
}
