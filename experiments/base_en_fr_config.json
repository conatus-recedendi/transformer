{
  "experiment_name": "transformer_base_en_fr",
  "description": "Base Transformer model for WMT 2014 English-French translation",

  "model": {
    "model_dim": 512,
    "num_heads": 8,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "ffn_dim": 2048,
    "dropout": 0.1,
    "max_seq_length": 512
  },

  "training": {
    "batch_size": 32,
    "learning_rate": 1e-4,
    "warmup_steps": 4000,
    "max_epochs": 100,
    "gradient_clip": 1.0,
    "tokens_per_batch": 25000,
    "max_tokens_per_batch": 25000,
    "accumulate_grad_batches": 1
  },

  "data": {
    "dataset": "wmt14_en_fr",
    "vocab_size": 32000,
    "shared_vocab": false,
    "encoding": "word_piece",
    "approximate_sentence_pairs": 36000000,
    "pad_token": 0,
    "bos_token": 1,
    "eos_token": 2,
    "unk_token": 3,
    "src_lang": "en",
    "tgt_lang": "fr"
  },

  "evaluation": {
    "eval_every": 1000,
    "save_every": 2000
  },

  "paths": {
    "data_path": "data/wmt14_en_fr/",
    "model_save_path": "checkpoints/base_en_fr/",
    "log_path": "logs/base_en_fr/"
  }
}
