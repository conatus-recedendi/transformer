{
  "experiment_name": "pytorch_transformer_base",
  "description": "Base configuration using PyTorch nn.Transformer",
  
  "model": {
    "model_type": "pytorch",
    "model_dim": 512,
    "num_heads": 8,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "ffn_dim": 2048,
    "dropout": 0.1,
    "max_seq_length": 512
  },
  
  "training": {
    "batch_size": 32,
    "learning_rate": 1e-4,
    "warmup_steps": 4000,
    "max_epochs": 100,
    "gradient_clip": 1.0,
    "tokens_per_batch": 25000,
    "max_tokens_per_batch": 25000,
    "accumulate_grad_batches": 1,
    "debug_output_every": 100,
    "enable_output_debug": false
  },
  
  "data": {
    "dataset": "wmt14_en_de",
    "vocab_size": 37000,
    "src_vocab_size": 37000,
    "tgt_vocab_size": 37000,
    "shared_vocab": true,
    "encoding": "bpe",
    "approximate_sentence_pairs": 4521000,
    "train_pairs": 4521000,
    "val_pairs": 500000,
    "pad_token": 0,
    "bos_token": 1,
    "eos_token": 2,
    "unk_token": 3,
    "src_lang": "en",
    "tgt_lang": "de"
  },
  
  "evaluation": {
    "eval_every": 500,
    "save_every": 1000,
    "n_checkpoints": 5,
    "beam_size": 4,
    "length_penalty": 0.6
  },
  
  "paths": {
    "data_path": "data/",
    "model_save_path": "checkpoints/",
    "log_path": "logs/"
  }
}
